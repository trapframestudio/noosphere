# Terrain3D channel-packed textures (Albedo+Height, Normal+Roughness),
# generated by `scripts/pack_terrain3d_textures.py` from the per-bundle
# diff/normal/rough/displacement sources above. Kept allowlisted because
# they're the texture data Terrain3D's shader actually samples — the
# unpacked sources stay around for the Rust `TerrainNode` shader.
!godot/assets/textures/terrain/_terrain3d_packed/
!godot/assets/textures/terrain/_terrain3d_packed/**/

# Visual Studio scaffolding (shipped in some third-party addons)
.vs/

# Terrain3D ships a bundled `demo/` reference project alongside the
# addon. Useful to peek at upstream as docs but not needed in our
# repo — pull from https://github.com/TokisanGames/Terrain3D when
# referencing.
godot/demo/

# Transient Blender exchange PNGs. Generated on demand by
# `cargo run --example r16_to_png -p simn-terrain`; authored edits are
# pushed back through `png_to_r16` into the canonical .r16. The .r16
# is the committed source of truth.
godot/assets/terrain/*/heightmap.png

# Biome-driven static-foliage scatter — generated locally for visual
# debugging of the StaticFoliageNode + GDScript driver via:
#   cargo run -p simn-terrain --example synth_static_foliage -- \
#       --from-map godot/assets/terrain/<map_id>
# The output is 4000+ chunk files (~1.2 MB total per map) — too noisy
# to commit. The real bake step (item 4 of static-foliage-plan.md)
# will produce something stable + committable. The integration test
# uses a tempdir fixture, so this gitignore doesn't affect tests.
godot/assets/terrain/*/static_foliage/*.bin
godot/assets/terrain/*/static_foliage/chunks_index.toml
godot/assets/terrain/*/static_foliage/species.toml

# Purchased/licensed assets (Megascans/CGTrader) live in the private
# asset repo, fetched via scripts. foliage_bake is a regenerable cache.
/godot/assets/models/
/godot/assets/textures/
/godot/assets/foliage_bake/
