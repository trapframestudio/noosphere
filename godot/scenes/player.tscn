[sub_resource type="StandardMaterial3D" id="PillMat"]
albedo_color = Color(0.3, 0.7, 1.0, 1.0)

; collision_layer = 4 (bit 2 = NPC_HITBOX) — humanoid bodies share
; this layer so LOS raycasts (mask = SOLID | CONCEALMENT) never
; occlude sight lines *to* or *from* a humanoid. See
; `godot/scripts/layers.gd` and `crates/simn-godot/src/los.rs`.
; collision_mask = 5 (SOLID | NPC_HITBOX) — player stops on world
; geometry and on NPC dummies, but walks through CONCEALMENT
; (bushes, smoke). Mirrors `Layers.PLAYER_MOVE_MASK`. Must match
; player.gd's `_apply_mode` walk-mode values.
[node name="Player" type="CharacterBody3D"]
collision_layer = 4
collision_mask = 5
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("CapsuleShape3D_1")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
mesh = SubResource("CapsuleMesh_1")
material_override = SubResource("PillMat")

[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)

[node name="Camera3D" type="Camera3D" parent="Head"]
current = true

; Kick zone for procedural trash. Slightly wider (0.7m) and same
; height (1.8m) as the player capsule so the player's leading
; "kick reach" extends a bit past the body. monitorable=false
; (nothing else needs to detect the zone) but monitoring=true (the
; zone needs to detect bodies entering it). collision_mask=2 =
; Layers.CONCEALMENT — sees the trash species's collision_layer.
; See trash_kick_zone.gd for the unfreeze + impulse handler.
[node name="TrashKickZone" type="Area3D" parent="."]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("2_kickzone")

[node name="CollisionShape3D" type="CollisionShape3D" parent="TrashKickZone"]
shape = SubResource("KickZoneShape")
